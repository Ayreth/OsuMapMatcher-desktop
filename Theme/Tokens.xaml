<!--
  Kensa "Console" tokens, converted from the OKLCH values in tokens.css.
  Surfaces climb one paper step per nesting level; the pink accent means
  "the map you are searching from" and the focus ring, nothing else.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- surfaces -->
  <Color x:Key="PaperColor">#0A0A0C</Color>
  <Color x:Key="Paper2Color">#0F0F12</Color>
  <Color x:Key="Paper3Color">#161619</Color>
  <Color x:Key="Paper4Color">#1C1C20</Color>
  <Color x:Key="RuleColor">#212124</Color>
  <Color x:Key="RuleStrongColor">#353539</Color>

  <!-- ink -->
  <Color x:Key="InkColor">#F1F1F4</Color>
  <Color x:Key="Ink2Color">#AAAAB1</Color>
  <Color x:Key="Ink3Color">#74747A</Color>
  <Color x:Key="Ink4Color">#4C4C51</Color>

  <Color x:Key="AccentColor">#F471AA</Color>

  <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}" />
  <SolidColorBrush x:Key="Paper2" Color="{StaticResource Paper2Color}" />
  <SolidColorBrush x:Key="Paper3" Color="{StaticResource Paper3Color}" />
  <SolidColorBrush x:Key="Paper4" Color="{StaticResource Paper4Color}" />
  <SolidColorBrush x:Key="Rule" Color="{StaticResource RuleColor}" />
  <SolidColorBrush x:Key="RuleStrong" Color="{StaticResource RuleStrongColor}" />
  <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="Ink2" Color="{StaticResource Ink2Color}" />
  <SolidColorBrush x:Key="Ink3" Color="{StaticResource Ink3Color}" />
  <SolidColorBrush x:Key="Ink4" Color="{StaticResource Ink4Color}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSoft" Color="#24F471AA" />
  <SolidColorBrush x:Key="PrimaryHover" Color="#D7D7DA" />

  <!-- data: the crowd is grey, groups get the muted ghost hues -->
  <SolidColorBrush x:Key="DataTop" Color="#9D9DA6" />
  <SolidColorBrush x:Key="DataTopSoft" Color="#299D9DA6" />
  <SolidColorBrush x:Key="Ghost1" Color="#73B1E6" />
  <SolidColorBrush x:Key="Ghost2" Color="#DAC46D" />
  <SolidColorBrush x:Key="Ghost3" Color="#B093E5" />
  <SolidColorBrush x:Key="Ghost4" Color="#5CC6B9" />
  <SolidColorBrush x:Key="Ghost5" Color="#E09865" />

  <!-- status: small dots and tags only -->
  <SolidColorBrush x:Key="Ok" Color="#6DC88F" />
  <SolidColorBrush x:Key="Warn" Color="#E6B55D" />
  <SolidColorBrush x:Key="Alert" Color="#F3625D" />
  <SolidColorBrush x:Key="OkSoft" Color="#1F6DC88F" />
  <SolidColorBrush x:Key="WarnSoft" Color="#1FE6B55D" />
  <SolidColorBrush x:Key="AlertSoft" Color="#24F3625D" />

  <!-- type -->
  <FontFamily x:Key="Sans">pack://application:,,,/Fonts/#Geist</FontFamily>
  <FontFamily x:Key="Mono">pack://application:,,,/Fonts/#Geist Mono</FontFamily>
  <FontFamily x:Key="Serif">pack://application:,,,/Fonts/#Instrument Serif</FontFamily>

  <sys:Double x:Key="Text2xs">11</sys:Double>
  <sys:Double x:Key="TextXs">12</sys:Double>
  <sys:Double x:Key="TextSm">13</sys:Double>
  <sys:Double x:Key="TextMd">14</sys:Double>
  <sys:Double x:Key="TextBase">15</sys:Double>
  <sys:Double x:Key="TextLg">18</sys:Double>
  <sys:Double x:Key="TextXl">22</sys:Double>

  <CornerRadius x:Key="RadiusPanel">10</CornerRadius>
  <CornerRadius x:Key="RadiusControl">6</CornerRadius>
  <CornerRadius x:Key="RadiusChip">4</CornerRadius>

  <!-- lucide icons, 24 px grid, stroked -->
  <Geometry x:Key="IconArrowLeft">M12 19L5 12L12 5 M19 12H5</Geometry>
  <Geometry x:Key="IconChevronDown">M6 9L12 15L18 9</Geometry>
  <Geometry x:Key="IconExternal">M15 3H21V9 M10 14L21 3 M18 13V19A2 2 0 0 1 16 21H5A2 2 0 0 1 3 19V8A2 2 0 0 1 5 6H11</Geometry>
  <Geometry x:Key="IconDownload">M21 15V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V15 M7 10L12 15L17 10 M12 15V3</Geometry>
  <Geometry x:Key="IconSearch">M19 11A8 8 0 1 1 3 11A8 8 0 0 1 19 11Z M21 21L16.7 16.7</Geometry>
  <Geometry x:Key="IconInfo">M22 12A10 10 0 1 1 2 12A10 10 0 0 1 22 12Z M12 16V12 M12 8H12.01</Geometry>
  <Geometry x:Key="IconX">M18 6L6 18 M6 6L18 18</Geometry>
  <Geometry x:Key="IconMinus">M5 12H19</Geometry>
  <Geometry x:Key="IconSquare">M5 5H19V19H5Z</Geometry>
  <Geometry x:Key="IconRestore">M8 8H19V19H8Z M5 15V5H15</Geometry>
  <Geometry x:Key="IconCrosshair">M22 12A10 10 0 1 1 2 12A10 10 0 0 1 22 12Z M22 12H18 M6 12H2 M12 6V2 M12 22V18</Geometry>
  <Geometry x:Key="IconReset">M3 12A9 9 0 1 0 12 3A9.75 9.75 0 0 0 5.26 5.74L3 8 M3 3V8H8</Geometry>
  <Geometry x:Key="IconSettings">M21 4H14 M10 4H3 M21 12H12 M8 12H3 M21 20H16 M12 20H3 M14 2V6 M8 10V14 M16 18V22</Geometry>
  <Geometry x:Key="IconCopy">M10 8H20V20H10Z M4 16V6A2 2 0 0 1 6 4H16</Geometry>
</ResourceDictionary>
