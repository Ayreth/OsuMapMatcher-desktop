<!--
  Every control the window uses, re-templated in the Kensa "Console" look.
  Fluent stays underneath only for what is not listed here.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:MapMatcher.Ui">

  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="/Theme/Tokens.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ===== focus: 2 px pink ring, 2 px offset, keyboard focus only ===== -->
  <FocusAdornerTemplate x:Key="FocusRing">
    <Border Margin="-3" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="8" />
  </FocusAdornerTemplate>

  <!-- ===== text ===== -->
  <ControlTheme x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource TextXs}" />
    <Setter Property="Foreground" Value="{StaticResource Ink4}" />
  </ControlTheme>
  <ControlTheme x:Key="MonoValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="{StaticResource TextBase}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </ControlTheme>
  <ControlTheme x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource TextXl}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </ControlTheme>

  <!-- a small neutral tag: map status -->
  <ControlTheme x:Key="Tag" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Paper3}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </ControlTheme>

  <!-- ===== tooltip: the help lives here, not on the page ===== -->
  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    <Setter Property="Background" Value="{StaticResource Paper4}" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="FontFamily" Value="{StaticResource Sans}" />
    <Setter Property="FontSize" Value="{StaticResource TextSm}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" TextWrapping="Wrap" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ===== buttons ===== -->
  <ControlTheme x:Key="Btn" TargetType="Button">
    <Setter Property="FocusAdorner" Value="{StaticResource FocusRing}" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="{StaticResource Paper2}" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="FontSize" Value="{StaticResource TextMd}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Paper3}" />
      <Setter Property="BorderBrush" Value="{StaticResource Ink4}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Paper4}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <!-- primary is white, never coloured -->
  <ControlTheme x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{StaticResource Ink}" />
    <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
    <Setter Property="Foreground" Value="{StaticResource Paper}" />
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource PrimaryHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryHover}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource PrimaryHover}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="BtnQuiet" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Paper3}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Paper3}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="BtnSm" TargetType="Button" BasedOn="{StaticResource BtnQuiet}">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="{StaticResource TextSm}" />
    <Setter Property="FontWeight" Value="Normal" />
  </ControlTheme>

  <!-- link-like back button, as in "Back to the original report" -->
  <ControlTheme x:Key="BtnLink" TargetType="Button">
    <Setter Property="FocusAdorner" Value="{StaticResource FocusRing}" />
    <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="{StaticResource TextBase}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" Margin="0,2"
                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
  </ControlTheme>

  <!-- window caption buttons (Windows, where the window draws its own title bar) -->
  <ControlTheme x:Key="BtnCaption" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Foreground" Value="{StaticResource Ink3}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}"
                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Paper3}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="BtnClose" TargetType="Button" BasedOn="{StaticResource BtnCaption}">
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
    </Style>
  </ControlTheme>

  <!-- the settings button in the top bar: readable over any background, white when open -->
  <ControlTheme x:Key="SettingsToggle" TargetType="ToggleButton">
    <Setter Property="Height" Value="30" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="#D90F0F12" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleStrong}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusControl}" Padding="10,0,12,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Icon Data="{StaticResource IconSettings}" Width="15" Height="15" Margin="0,0,7,0" />
            <TextBlock Text="Settings" FontSize="{StaticResource TextSm}" FontWeight="Medium" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{StaticResource Paper4}" />
      <Setter Property="BorderBrush" Value="{StaticResource Ink4}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
      <Setter Property="Foreground" Value="{StaticResource Paper}" />
    </Style>
  </ControlTheme>

  <!-- the Info bubble: help text goes in a tooltip -->
  <ControlTheme x:Key="InfoDot" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Help" />
    <Setter Property="ToolTip.ShowDelay" Value="150" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" Padding="2">
          <ui:Icon Name="i" Data="{StaticResource IconInfo}" Width="14" Height="14" Foreground="{StaticResource Ink4}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ ui|Icon#i">
      <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    </Style>
  </ControlTheme>

  <!-- the osu! button on each suggestion: round, neutral, readable -->
  <ControlTheme x:Key="BtnOsu" TargetType="Button">
    <Setter Property="FocusAdorner" Value="{StaticResource FocusRing}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Ellipse Name="e" Fill="{StaticResource Paper3}" Stroke="{StaticResource RuleStrong}" StrokeThickness="1" />
          <TextBlock Name="t" Text="osu!" FontWeight="Normal" FontSize="10.5" Foreground="{StaticResource Ink}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,1" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Ellipse#e">
      <Setter Property="Fill" Value="{StaticResource Ink}" />
      <Setter Property="Stroke" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="^:pointerover /template/ TextBlock#t">
      <Setter Property="Foreground" Value="{StaticResource Paper}" />
    </Style>
    <Style Selector="^:pressed /template/ Ellipse#e">
      <Setter Property="Fill" Value="{StaticResource PrimaryHover}" />
    </Style>
  </ControlTheme>

  <!-- ===== text box ===== -->
  <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
    <Setter Property="Height" Value="34" />
    <Setter Property="Background" Value="{StaticResource Paper}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Ink3}" />
    <Setter Property="SelectionForegroundBrush" Value="{StaticResource Ink}" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="FontSize" Value="{StaticResource TextMd}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <ScrollViewer Name="PART_ScrollViewer" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                        HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                        VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
            <Panel>
              <TextBlock Name="ph" Text="{TemplateBinding Watermark}" Foreground="{StaticResource Ink4}" IsHitTestVisible="False"
                         Padding="2,0,0,0" VerticalAlignment="Center"
                         IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
              <TextPresenter Name="PART_TextPresenter"
                             Text="{TemplateBinding Text, Mode=TwoWay}"
                             CaretBrush="{TemplateBinding CaretBrush}"
                             CaretIndex="{TemplateBinding CaretIndex}"
                             SelectionBrush="{TemplateBinding SelectionBrush}"
                             SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                             SelectionStart="{TemplateBinding SelectionStart}"
                             SelectionEnd="{TemplateBinding SelectionEnd}"
                             PasswordChar="{TemplateBinding PasswordChar}"
                             RevealPassword="{TemplateBinding RevealPassword}"
                             TextAlignment="{TemplateBinding TextAlignment}"
                             TextWrapping="{TemplateBinding TextWrapping}"
                             LineHeight="{TemplateBinding LineHeight}"
                             VerticalAlignment="Center" />
            </Panel>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#b">
      <Setter Property="BorderBrush" Value="{StaticResource Ink4}" />
    </Style>
    <Style Selector="^:focus /template/ Border#b">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
  </ControlTheme>

  <!-- ===== check box ===== -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="FocusAdorner" Value="{StaticResource FocusRing}" />
    <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    <Setter Property="FontSize" Value="{StaticResource TextSm}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" Background="Transparent">
          <Border Name="box" Width="16" Height="16" CornerRadius="4" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0"
                  BorderBrush="{StaticResource RuleStrong}" Background="{StaticResource Paper}">
            <Path Name="tick" Data="M4 8.5L7 11.5L12.5 5" Stroke="{StaticResource Paper}" StrokeThickness="1.8"
                  StrokeLineCap="Round" StrokeJoin="Round" IsVisible="False" />
          </Border>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextWrapping="Wrap" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#box">
      <Setter Property="BorderBrush" Value="{StaticResource Ink4}" />
    </Style>
    <Style Selector="^:checked /template/ Border#box">
      <Setter Property="Background" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="^:checked /template/ Path#tick">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <!-- ===== sliders ===== -->
  <ControlTheme x:Key="SliderTrackButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Height="2" CornerRadius="1" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="SliderThumb" TargetType="Thumb">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Width="16" Height="22" Background="Transparent">
          <Ellipse Name="e" Width="12" Height="12" Fill="{StaticResource Ink}" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Ellipse#e">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
  </ControlTheme>

  <!-- filled from the left: weights, filters. Foreground fills, Background is the rest of the rail -->
  <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
    <Setter Property="FocusAdorner" Value="{StaticResource FocusRing}" />
    <Setter Property="IsSnapToTickEnabled" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource Ink3}" />
    <Setter Property="Background" Value="{StaticResource RuleStrong}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Width="1" Height="8" Background="{StaticResource Ink4}" HorizontalAlignment="Center"
                  IsVisible="{TemplateBinding Tag, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Track Name="PART_Track" Height="22" Orientation="Horizontal"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource SliderTrackButton}" Background="{TemplateBinding Foreground}" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource SliderTrackButton}" Background="{TemplateBinding Background}" />
            </Track.IncreaseButton>
            <Thumb Name="thumb" Theme="{StaticResource SliderThumb}" />
          </Track>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- centred: steer goes both ways from "straight", marked by a tick in the middle -->
  <ControlTheme x:Key="SliderCentered" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
    <Setter Property="Foreground" Value="{StaticResource RuleStrong}" />
    <Setter Property="Tag" Value="centred" />
  </ControlTheme>

  <!-- ===== combo box ===== -->
  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="{StaticResource TextMd}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" CornerRadius="4" Padding="10,7"
                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="{StaticResource Paper3}" />
    </Style>
    <Style Selector="^:focus">
      <Setter Property="Background" Value="{StaticResource Paper3}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="FocusAdorner" Value="{StaticResource FocusRing}" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="{StaticResource Paper}" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleStrong}" />
    <Setter Property="FontSize" Value="{StaticResource TextMd}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MaxDropDownHeight" Value="300" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusControl}" />
          <ContentPresenter Name="ContentPresenter" Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                            Margin="10,0,34,0" VerticalAlignment="Center" />
          <ui:Icon Name="chev" Data="{StaticResource IconChevronDown}" Width="14" Height="14" Foreground="{StaticResource Ink3}"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
          <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                 MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                 MaxHeight="{TemplateBinding MaxDropDownHeight}"
                 PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                 Placement="Bottom" VerticalOffset="4" IsLightDismissEnabled="True" InheritsTransform="True">
            <Border Background="{StaticResource Paper4}" BorderBrush="{StaticResource RuleStrong}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}" Padding="4">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#b">
      <Setter Property="BorderBrush" Value="{StaticResource Ink4}" />
    </Style>
    <Style Selector="^:dropdownopen /template/ ui|Icon#chev">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
  </ControlTheme>

  <!-- ===== scroll bars: thin, out of the way, beside the content rather than over it ===== -->
  <ControlTheme x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Background" Value="{StaticResource Paper4}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="2" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{StaticResource RuleStrong}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{StaticResource Ink4}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="AllowAutoHide" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Track Name="track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                 Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
            <Thumb Name="thumb" Theme="{StaticResource ScrollThumb}" />
          </Track>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:vertical">
      <Setter Property="Width" Value="10" />
    </Style>
    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="^:horizontal /template/ Track#track">
      <Setter Property="IsDirectionReversed" Value="False" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollViewer}" TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
          <ScrollContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}"
                                  Padding="{TemplateBinding Padding}" />
          <ScrollBar Name="PART_HorizontalScrollBar" Orientation="Horizontal" Grid.Row="1" />
          <ScrollBar Name="PART_VerticalScrollBar" Orientation="Vertical" Grid.Column="1" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ===== settings section: header toggles, chevron turns ===== -->
  <ControlTheme x:Key="SectionToggle" TargetType="ToggleButton">
    <Setter Property="FocusAdorner" Value="{StaticResource FocusRing}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="b" Background="{TemplateBinding Background}" Padding="20,14">
          <Grid ColumnDefinitions="*,Auto">
            <ContentPresenter Name="PART_ContentPresenter" VerticalAlignment="Center"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            <ui:Icon Name="chev" Grid.Column="1" Data="{StaticResource IconChevronDown}" Width="15" Height="15"
                     Foreground="{StaticResource Ink4}" Margin="10,0,0,0" RenderTransform="rotate(0deg)">
              <ui:Icon.Transitions>
                <Transitions>
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="ExponentialEaseOut" />
                </Transitions>
              </ui:Icon.Transitions>
            </ui:Icon>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{StaticResource Paper3}" />
    </Style>
    <Style Selector="^:pointerover /template/ ui|Icon#chev">
      <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    </Style>
    <Style Selector="^:checked /template/ ui|Icon#chev">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
