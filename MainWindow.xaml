<Window x:Class="MapMatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MapMatcher.Ui"
        Title="MapMatcher" Width="560" Height="780" MinWidth="420" MinHeight="520"
        Background="{StaticResource Paper}" Foreground="{StaticResource Ink2}"
        FontFamily="{StaticResource Sans}" FontSize="{StaticResource TextMd}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <ui:BoolToVisibility x:Key="Vis" />

    <!-- slider row: label, rail, value -->
    <DataTemplate x:Key="SliderRowTemplate" DataType="{x:Type ui:SliderRow}">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="104" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="52" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding Help}"
                    ToolTipService.InitialShowDelay="250">
          <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Swatch}" Margin="0,0,8,0"
                  Visibility="{Binding HasSwatch, Converter={StaticResource Vis}}" />
          <TextBlock Text="{Binding Label}" Foreground="{StaticResource Ink2}" FontSize="{StaticResource TextSm}" />
        </StackPanel>
        <Slider Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}" TickFrequency="{Binding Step}"
                SmallChange="{Binding Step}" LargeChange="{Binding Step}" Value="{Binding Value, Mode=TwoWay}"
                AutomationProperties.Name="{Binding Label}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding Display}" Style="{StaticResource MonoValue}" FontSize="{StaticResource TextSm}"
                   HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- steer row: centred rail, the asked phrase on the right -->
    <DataTemplate x:Key="SteerRowTemplate" DataType="{x:Type ui:SliderRow}">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="104" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="112" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Ink2}" FontSize="{StaticResource TextSm}" VerticalAlignment="Center"
                   Background="Transparent" ToolTip="{Binding Help}" ToolTipService.InitialShowDelay="250" />
        <Slider Grid.Column="1" Style="{StaticResource SliderCentered}" Minimum="{Binding Min}" Maximum="{Binding Max}"
                TickFrequency="{Binding Step}" SmallChange="{Binding Step}" LargeChange="{Binding Step}"
                Value="{Binding Value, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding Display}" FontSize="{StaticResource TextXs}" TextAlignment="Right"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource Ink4}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsOff}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Ink}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </DataTemplate>

    <!-- one suggestion: a rule-separated row, details fold out below -->
    <DataTemplate x:Key="MatchTemplate" DataType="{x:Type ui:MatchVm}">
      <Border x:Name="row" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Background="Transparent"
              Focusable="True" FocusVisualStyle="{StaticResource FocusRing}" Cursor="Hand"
              MouseLeftButtonUp="Row_Click" KeyDown="Row_KeyDown">
        <StackPanel>
          <Grid>
            <!-- the cover sits on the left and fades into the row -->
            <Rectangle Width="210" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0.22">
              <Rectangle.Fill>
                <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" AlignmentX="Left" />
              </Rectangle.Fill>
              <Rectangle.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#FF000000" Offset="0" />
                  <GradientStop Color="#B3000000" Offset="0.4" />
                  <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.OpacityMask>
            </Rectangle>
            <Grid Margin="96,14,16,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="26" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}" FontWeight="Medium" FontSize="{StaticResource TextMd}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock TextTrimming="CharacterEllipsis" FontSize="{StaticResource TextSm}" Margin="0,3,0,0">
                  <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource Ink2}" />
                  <Run Text=" · " Foreground="{StaticResource Ink4}" /><Run Text="{Binding Creator, Mode=OneWay}" Foreground="{StaticResource Ink3}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <TextBlock Style="{StaticResource MonoValue}" FontSize="{StaticResource TextXs}" Foreground="{StaticResource Ink2}"
                             VerticalAlignment="Center">
                    <Run Text="{Binding Stars, Mode=OneWay}" /><Run Text="★" Foreground="{StaticResource Ink4}" />
                    <Run Text="  " /><Run Text="{Binding Bpm, Mode=OneWay}" /><Run Text=" bpm" Foreground="{StaticResource Ink4}" />
                    <Run Text="  " /><Run Text="{Binding Length, Mode=OneWay}" />
                  </TextBlock>
                  <Border Style="{StaticResource Tag}" Margin="10,0,0,0" ToolTip="{Binding StatusHelp}"
                          Visibility="{Binding HasStatusTag, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding StatusTag}" FontFamily="{StaticResource Mono}" FontSize="{StaticResource Text2xs}"
                               Foreground="{StaticResource Ink3}" />
                  </Border>
                </StackPanel>
              </StackPanel>
              <!-- osu! button: in game or in the browser, per the setting -->
              <Button Grid.Column="1" Style="{StaticResource BtnOsu}" Click="Osu_Click" VerticalAlignment="Center" Margin="0,0,14,0"
                      ToolTip="{Binding OsuHelp}" AutomationProperties.Name="Open in osu!" />
              <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                          ToolTip="How closely it plays like your map">
                <TextBlock Style="{StaticResource MonoValue}" HorizontalAlignment="Right" FontSize="17">
                  <Run Text="{Binding MatchPct, Mode=OneWay}" /><Run Text="%" Foreground="{StaticResource Ink4}" FontSize="{StaticResource TextXs}" />
                </TextBlock>
                <Grid Width="40" Height="2" Margin="0,6,0,0" HorizontalAlignment="Right">
                  <Border Background="{StaticResource RuleStrong}" CornerRadius="1" />
                  <Border Background="{StaticResource Ink2}" CornerRadius="1" Width="{Binding MatchFill}" HorizontalAlignment="Left" />
                </Grid>
              </StackPanel>
              <ui:Icon x:Name="chev" Grid.Column="3" Data="{StaticResource IconChevronDown}" Width="15" Height="15"
                       Foreground="{StaticResource Ink4}" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <ui:Icon.RenderTransform>
                  <RotateTransform />
                </ui:Icon.RenderTransform>
              </ui:Icon>
            </Grid>
          </Grid>

          <!-- why this map -->
          <Border x:Name="detail" Visibility="Collapsed" Padding="24,4,18,18">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoValue}" FontSize="{StaticResource TextXs}" Foreground="{StaticResource Ink4}">
                  <Run Text="distance " /><Run Text="{Binding Distance, Mode=OneWay}" Foreground="{StaticResource Ink2}" />
                </TextBlock>
                <TextBlock Text="Where the distance comes from" Style="{StaticResource Label}" />
              </DockPanel>
              <ui:ShareBarView Bars="{Binding Bars}" Margin="0,8,0,0" />
              <ItemsControl ItemsSource="{Binding Bars}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                      <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Brush}" Margin="0,0,6,0" />
                      <TextBlock FontSize="{StaticResource TextXs}">
                        <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource Ink3}" />
                        <Run Text="{Binding Pct, Mode=OneWay}" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Ink2}" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Differs" Style="{StaticResource Label}" Margin="0,1,0,0"
                           Visibility="{Binding HasWhyDifferent, Converter={StaticResource Vis}}" />
                <TextBlock Grid.Column="1" Text="{Binding WhyDifferent}" Foreground="{StaticResource Ink}" TextWrapping="Wrap"
                           FontSize="{StaticResource TextSm}" LineHeight="20"
                           Visibility="{Binding HasWhyDifferent, Converter={StaticResource Vis}}" />
                <TextBlock Grid.Row="1" Text="Same" Style="{StaticResource Label}" Margin="0,7,0,0"
                           Visibility="{Binding HasWhySame, Converter={StaticResource Vis}}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WhySame}" Foreground="{StaticResource Ink3}" TextWrapping="Wrap"
                           FontSize="{StaticResource TextSm}" LineHeight="20" Margin="0,6,0,0"
                           Visibility="{Binding HasWhySame, Converter={StaticResource Vis}}" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="No notable difference." Foreground="{StaticResource Ink3}"
                           FontSize="{StaticResource TextSm}" Visibility="{Binding NoWhy, Converter={StaticResource Vis}}" />
              </Grid>

              <WrapPanel Margin="0,14,0,0">
                <Button Style="{StaticResource BtnQuiet}" Click="Pivot_Click" Margin="0,0,8,8"
                        ToolTip="Search from this map instead, without touching the game.">
                  <StackPanel Orientation="Horizontal">
                    <ui:Icon Data="{StaticResource IconCrosshair}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0" />
                    <TextBlock Text="Maps like this one" />
                  </StackPanel>
                </Button>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
          <Setter TargetName="row" Property="Background" Value="{StaticResource Paper2}" />
          <Setter TargetName="chev" Property="Foreground" Value="{StaticResource Ink2}" />
        </Trigger>
        <DataTrigger Binding="{Binding IsOpen}" Value="True">
          <Setter TargetName="row" Property="Background" Value="{StaticResource Paper2}" />
          <Setter TargetName="detail" Property="Visibility" Value="Visible" />
          <Setter TargetName="chev" Property="RenderTransform">
            <Setter.Value>
              <RotateTransform Angle="180" />
            </Setter.Value>
          </Setter>
          <Setter TargetName="chev" Property="Foreground" Value="{StaticResource Ink}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ================= hero background: the map you search from ================= -->
    <Grid Grid.Row="0" Grid.RowSpan="2" ClipToBounds="True">
      <!-- a brush, not an Image: a picture must never size the layout -->
      <Rectangle x:Name="HeroImage" Opacity="0">
        <Rectangle.Fill>
          <ImageBrush x:Name="HeroBrush" Stretch="UniformToFill" AlignmentY="Center" />
        </Rectangle.Fill>
      </Rectangle>
      <Border Background="#8C0A0A0C" />
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#FF0A0A0C" Offset="0" />
            <GradientStop Color="#B30A0A0C" Offset="0.4" />
            <GradientStop Color="#330A0A0C" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Grid>

    <!-- ================= top bar ================= -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="MapMatcher" FontFamily="{StaticResource Serif}" FontSize="25" Foreground="{StaticResource Ink}"
                 VerticalAlignment="Bottom" Margin="24,0,0,0" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
        <!-- settings: a real button, readable over any background -->
        <ToggleButton x:Name="SettingsButton" Height="30" Focusable="False" ToolTip="Weights, steer, filters"
                      Margin="0,8,10,0" VerticalAlignment="Top" Cursor="Hand"
                      Checked="Settings_Toggled" Unchecked="Settings_Toggled">
          <ToggleButton.Template>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="b" Background="#D90F0F12" BorderBrush="{StaticResource RuleStrong}" BorderThickness="1"
                      CornerRadius="{StaticResource RadiusControl}" Padding="10,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ui:Icon x:Name="i" Data="{StaticResource IconSettings}" Width="15" Height="15" Foreground="{StaticResource Ink}" Margin="0,0,7,0" />
                  <TextBlock x:Name="t" Text="Settings" Foreground="{StaticResource Ink}" FontSize="{StaticResource TextSm}" FontWeight="Medium"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource Paper4}" />
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ink4}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource Ink}" />
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ink}" />
                  <Setter TargetName="i" Property="Foreground" Value="{StaticResource Paper}" />
                  <Setter TargetName="t" Property="Foreground" Value="{StaticResource Paper}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </ToggleButton.Template>
        </ToggleButton>
        <Button Style="{StaticResource BtnCaption}" Click="Minimize_Click" ToolTip="Minimize">
          <ui:Icon Data="{StaticResource IconMinus}" Width="14" Height="14" Stroke="1.5"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
        <Button Style="{StaticResource BtnCaption}" Click="Maximize_Click" ToolTip="Maximize">
          <ui:Icon x:Name="MaxIcon" Data="{StaticResource IconSquare}" Width="13" Height="13" Stroke="1.5"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
        <Button Style="{StaticResource BtnClose}" Click="Close_Click" ToolTip="Close">
          <ui:Icon Data="{StaticResource IconX}" Width="14" Height="14" Stroke="1.5"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ================= hero content ================= -->
    <Grid Grid.Row="1" MinHeight="236">
    <StackPanel VerticalAlignment="Bottom" Margin="24,12,24,48">
      <!-- a new release: a quiet strip, not a popup -->
      <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="#E6161619" BorderBrush="{StaticResource RuleStrong}"
              BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="12,6,6,6" Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="UpdateText" Foreground="{StaticResource Ink}" FontSize="{StaticResource TextSm}" VerticalAlignment="Center"
                     TextWrapping="Wrap" Text="A new version is out." />
          <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Height="28" Padding="10,0" FontSize="{StaticResource TextSm}"
                  Margin="10,0,4,0" Click="Update_Click" Content="Download" />
          <Button Grid.Column="2" Style="{StaticResource BtnSm}" Width="28" Padding="0" Click="UpdateDismiss_Click" ToolTip="Not now">
            <ui:Icon Data="{StaticResource IconX}" Width="13" Height="13"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
        </Grid>
      </Border>

      <Button x:Name="BackButton" Style="{StaticResource BtnLink}" Click="Back_Click" HorizontalAlignment="Left"
              Margin="0,0,0,14" Visibility="Collapsed" FontSize="{StaticResource TextMd}">
        <StackPanel Orientation="Horizontal">
          <ui:Icon Data="{StaticResource IconArrowLeft}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                   Margin="0,0,10,0" />
          <TextBlock Text="Back to the map selected in game" />
        </StackPanel>
      </Button>

      <TextBlock x:Name="HeroArtist" Text="" Foreground="{StaticResource Ink2}" FontSize="{StaticResource TextBase}"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource Serif}" FontSize="40" LineHeight="42"
                 LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource Ink}" TextWrapping="Wrap"
                 TextTrimming="CharacterEllipsis" MaxHeight="128" Margin="0,4,0,0">
        <Run x:Name="HeroTitleRun" Text="Waiting for a map" />
        <Run x:Name="HeroVersionRun" Text="" FontStyle="Italic" Foreground="{StaticResource Ink3}" />
        <Run x:Name="HeroMapperRun" Text="" FontFamily="{StaticResource Sans}" FontSize="16" Foreground="{StaticResource Ink3}" />
      </TextBlock>

      <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
        <TextBlock x:Name="HeroStats" Style="{StaticResource MonoValue}" FontSize="17" VerticalAlignment="Center" />
        <Border x:Name="HeroMods" Style="{StaticResource Tag}" Margin="14,0,0,0" Visibility="Collapsed">
          <TextBlock x:Name="HeroModsText" FontFamily="{StaticResource Mono}" FontSize="{StaticResource TextXs}" Foreground="{StaticResource Ink2}" />
        </Border>
      </StackPanel>
      <Border x:Name="HeroNotice" Margin="0,10,0,0" Visibility="Collapsed" HorizontalAlignment="Left"
              Background="{StaticResource WarnSoft}" CornerRadius="{StaticResource RadiusChip}" Padding="8,3">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="7" Height="7" Fill="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock x:Name="HeroNoticeText" FontFamily="{StaticResource Mono}" FontSize="{StaticResource TextXs}" Foreground="{StaticResource Warn}" />
        </StackPanel>
      </Border>
    </StackPanel>
    </Grid>

    <!-- ================= results ================= -->
    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0">
        <TextBlock x:Name="SummaryText" Text="" Foreground="{StaticResource Ink3}" FontSize="{StaticResource TextSm}"
                   Margin="24,10,24,10" TextWrapping="Wrap" Visibility="Collapsed" />
      </Border>

      <ScrollViewer x:Name="ResultsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Focusable="False">
        <ItemsControl x:Name="ResultsList" ItemTemplate="{StaticResource MatchTemplate}" Focusable="False" Margin="0,8,0,0" />
      </ScrollViewer>

      <!-- loading: shimmer text and a 2 px track, no spinner -->
      <StackPanel x:Name="LoadingPanel" Grid.Row="1" Margin="24,24,24,0" Visibility="Collapsed" VerticalAlignment="Top">
        <TextBlock x:Name="ShimmerText" Text="Finding maps that play like this one" FontSize="{StaticResource TextMd}">
          <TextBlock.Foreground>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
              <LinearGradientBrush.RelativeTransform>
                <TranslateTransform X="-1" />
              </LinearGradientBrush.RelativeTransform>
              <GradientStop Color="{StaticResource Ink3Color}" Offset="0" />
              <GradientStop Color="{StaticResource InkColor}" Offset="0.5" />
              <GradientStop Color="{StaticResource Ink3Color}" Offset="1" />
            </LinearGradientBrush>
          </TextBlock.Foreground>
        </TextBlock>
        <Grid Height="2" Width="240" HorizontalAlignment="Left" Margin="0,14,0,0" ClipToBounds="True">
          <Border Background="{StaticResource Rule}" />
          <Border Width="72" Background="{StaticResource Ink3}" HorizontalAlignment="Left">
            <Border.RenderTransform>
              <TranslateTransform x:Name="TrackMove" X="-72" />
            </Border.RenderTransform>
          </Border>
        </Grid>
      </StackPanel>

      <!-- empty / error -->
      <StackPanel x:Name="EmptyPanel" Grid.Row="1" Margin="24,24,24,0" VerticalAlignment="Top">
        <TextBlock x:Name="EmptyTitle" Text="No map yet" Foreground="{StaticResource Ink}" FontSize="{StaticResource TextBase}"
                   FontWeight="Medium" />
        <TextBlock x:Name="EmptyText" Foreground="{StaticResource Ink3}" FontSize="{StaticResource TextMd}" TextWrapping="Wrap"
                   LineHeight="21" Margin="0,6,0,0" />
      </StackPanel>
    </Grid>

    <!-- ================= settings: a panel over the list, opened from the top bar ================= -->
    <Grid x:Name="SettingsLayer" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
      <Border x:Name="SettingsScrim" Background="#990A0A0C" MouseLeftButtonDown="Scrim_Click" />
      <Border x:Name="SettingsPanel" HorizontalAlignment="Right" Width="400" Background="{StaticResource Paper2}"
              BorderBrush="{StaticResource RuleStrong}" BorderThickness="1,1,0,0">
        <Border.RenderTransform>
          <TranslateTransform x:Name="SettingsSlide" X="0" />
        </Border.RenderTransform>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel>

            <!-- general -->
            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="20,16,20,18">
              <StackPanel>
                <TextBlock Text="General" Foreground="{StaticResource Ink}" FontSize="{StaticResource TextBase}" FontWeight="SemiBold" />
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="osu! button" Foreground="{StaticResource Ink2}" FontSize="{StaticResource TextSm}" VerticalAlignment="Center"
                             Background="Transparent" ToolTip="What the osu! button on each suggestion does." />
                  <ComboBox x:Name="OsuTargetBox" Grid.Column="1" SelectionChanged="OsuTarget_Changed">
                    <ComboBoxItem Content="Opens it in game" Tag="game" />
                    <ComboBoxItem Content="Opens it in the browser" Tag="web" />
                  </ComboBox>
                </Grid>
                <CheckBox x:Name="OnTopBox" Margin="0,14,0,0" Checked="OnTop_Changed" Unchecked="OnTop_Changed">
                  <TextBlock Text="Keep this window on top" />
                </CheckBox>
              </StackPanel>
            </Border>

            <!-- weights -->
            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
              <StackPanel>
                <ToggleButton x:Name="WeightsToggle" Style="{StaticResource SectionToggle}" Tag="weights" Checked="Section_Changed" Unchecked="Section_Changed">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Weights" Foreground="{StaticResource Ink}" FontSize="{StaticResource TextBase}" FontWeight="SemiBold" />
                      <ContentControl Style="{StaticResource InfoDot}" Margin="8,1,0,0">
                        <ContentControl.ToolTip>
                          <TextBlock Text="What counts as similar. Raise a group and it weighs more when two maps are compared. Nothing is pushed in any direction: the same neighbours are measured differently. Not to be confused with Steer, which asks for something deliberately different." />
                        </ContentControl.ToolTip>
                      </ContentControl>
                    </StackPanel>
                    <TextBlock x:Name="WeightsSummary" Text="default" FontSize="{StaticResource TextXs}" Foreground="{StaticResource Ink3}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </ToggleButton>
                <StackPanel Visibility="{Binding IsChecked, ElementName=WeightsToggle, Converter={StaticResource Vis}}" Margin="20,0,20,18">
                  <ItemsControl x:Name="WeightsList" ItemTemplate="{StaticResource SliderRowTemplate}" Focusable="False" />
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="104" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Diverge on" Foreground="{StaticResource Ink2}" FontSize="{StaticResource TextSm}" VerticalAlignment="Center"
                               Background="Transparent"
                               ToolTip="Same difficulty, opposite challenge. Results stay close to your map on every group except the one you pick, and are then ranked by how far they are on it: an aim map when you came from a speed map. Useful for practising a weakness without changing level." />
                    <ComboBox x:Name="DivergeBox" Grid.Column="1" SelectionChanged="Diverge_Changed" />
                  </Grid>
                  <Button Style="{StaticResource BtnSm}" HorizontalAlignment="Left" Margin="-8,12,0,0" Click="ResetWeights_Click">
                    <StackPanel Orientation="Horizontal">
                      <ui:Icon Data="{StaticResource IconReset}" Width="13" Height="13" Margin="0,0,6,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                      <TextBlock Text="Reset weights" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- steer -->
            <Border x:Name="SteerSection" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Visibility="Collapsed">
              <StackPanel>
                <ToggleButton x:Name="SteerToggle" Style="{StaticResource SectionToggle}" Tag="steer" Checked="Section_Changed" Unchecked="Section_Changed">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Steer" Foreground="{StaticResource Ink}" FontSize="{StaticResource TextBase}" FontWeight="SemiBold" />
                      <ContentControl Style="{StaticResource InfoDot}" Margin="8,1,0,0">
                        <ContentControl.ToolTip>
                          <TextBlock Text="What should be different: like this map, but denser. Maps that do not really clear the gap you ask for are dropped, so push too far and the list comes back empty. That is an honest answer: nothing indexed goes that far and still resembles this map." />
                        </ContentControl.ToolTip>
                      </ContentControl>
                    </StackPanel>
                    <TextBlock x:Name="SteerSummary" Text="straight ahead" FontSize="{StaticResource TextXs}" Foreground="{StaticResource Ink3}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </ToggleButton>
                <StackPanel Visibility="{Binding IsChecked, ElementName=SteerToggle, Converter={StaticResource Vis}}" Margin="20,0,20,18">
                  <ItemsControl x:Name="SteerList" ItemTemplate="{StaticResource SteerRowTemplate}" Focusable="False" />
                  <Button Style="{StaticResource BtnSm}" HorizontalAlignment="Left" Margin="-8,12,0,0" Click="ResetSteer_Click">
                    <StackPanel Orientation="Horizontal">
                      <ui:Icon Data="{StaticResource IconReset}" Width="13" Height="13" Margin="0,0,6,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                      <TextBlock Text="Straight ahead" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- filters -->
            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
              <StackPanel>
                <ToggleButton x:Name="FiltersToggle" Style="{StaticResource SectionToggle}" Tag="filters" Checked="Section_Changed" Unchecked="Section_Changed">
                  <StackPanel>
                    <TextBlock Text="Filters" Foreground="{StaticResource Ink}" FontSize="{StaticResource TextBase}" FontWeight="SemiBold" />
                    <TextBlock x:Name="FiltersSummary" Text="default" FontSize="{StaticResource TextXs}" Foreground="{StaticResource Ink3}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </ToggleButton>
                <StackPanel Visibility="{Binding IsChecked, ElementName=FiltersToggle, Converter={StaticResource Vis}}" Margin="20,0,20,18">
                  <ItemsControl x:Name="FiltersList" ItemTemplate="{StaticResource SliderRowTemplate}" Focusable="False" />
                  <CheckBox x:Name="SameSetBox" Margin="0,14,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"
                            ToolTip="Other difficulties of the same set are near-identical by construction: they teach you nothing.">
                    <TextBlock Text="Exclude other difficulties of the same set" />
                  </CheckBox>
                  <CheckBox x:Name="OnePerSongBox" Margin="0,10,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"
                            ToolTip="Keep only the best-matching difficulty per song, so one popular track cannot fill half the list.">
                    <TextBlock Text="One difficulty per song" />
                  </CheckBox>
                  <CheckBox x:Name="UnrankedBox" Margin="0,10,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"
                            ToolTip="Heavily played graveyard and pending maps are in the pool too. Uncheck to keep only ranked and loved maps.">
                    <TextBlock Text="Include unranked maps" />
                  </CheckBox>
                  <Button Style="{StaticResource BtnSm}" HorizontalAlignment="Left" Margin="-8,12,0,0" Click="ResetFilters_Click">
                    <StackPanel Orientation="Horizontal">
                      <ui:Icon Data="{StaticResource IconReset}" Width="13" Height="13" Margin="0,0,6,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                      <TextBlock Text="Reset filters" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- connection -->
            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
              <StackPanel>
                <ToggleButton x:Name="ConnectionToggle" Style="{StaticResource SectionToggle}" Tag="connection" Checked="Section_Changed" Unchecked="Section_Changed">
                  <StackPanel>
                    <TextBlock Text="Connection" Foreground="{StaticResource Ink}" FontSize="{StaticResource TextBase}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Alert}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBlock x:Name="StatusText" Text="looking for the game" FontFamily="{StaticResource Mono}" FontSize="{StaticResource TextXs}"
                                 Foreground="{StaticResource Ink2}" />
                    </StackPanel>
                  </StackPanel>
                </ToggleButton>
                <StackPanel Visibility="{Binding IsChecked, ElementName=ConnectionToggle, Converter={StaticResource Vis}}" Margin="20,0,20,20">
                  <TextBlock Foreground="{StaticResource Ink3}" FontSize="{StaticResource TextSm}" TextWrapping="Wrap" LineHeight="19"
                             Text="Nothing else has to run. osu!stable is read directly, read-only. Lazer and Torii are followed through their log and a copy of their beatmap database: their files are never written to. tosu, if open, is used instead." />
                  <TextBlock Text="Search server" Style="{StaticResource Label}" Margin="0,16,0,6" />
                  <TextBlock x:Name="EngineText" Text="…" FontFamily="{StaticResource Mono}" FontSize="{StaticResource TextXs}"
                             Foreground="{StaticResource Ink2}" Margin="0,0,0,8" />
                  <TextBox x:Name="ApiBox" Tag="auto: local server, then api.ayreth.site" FontFamily="{StaticResource Mono}" FontSize="{StaticResource TextSm}" />
                  <TextBlock Text="tosu address (optional)" Style="{StaticResource Label}" Margin="0,14,0,6" />
                  <TextBox x:Name="TosuBox" Tag="127.0.0.1:24050" FontFamily="{StaticResource Mono}" FontSize="{StaticResource TextSm}" />
                  <TextBlock Foreground="{StaticResource Ink4}" FontSize="{StaticResource TextXs}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="17"
                             Text="Only the map's checksum leaves your machine. A map the server has never seen is sent as its .osu, used and dropped." />
                  <Button Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="ApplyConnection_Click" Content="Reconnect" />
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Margin="20,18,20,24" FontSize="{StaticResource TextXs}" Foreground="{StaticResource Ink4}" TextWrapping="Wrap" LineHeight="17"
                       Text="Drop a .osu file on the window, or paste a beatmap link with Ctrl+V, to search from any map. A fan project, not affiliated with ppy." />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- drop target -->
    <Border x:Name="DropOverlay" Grid.RowSpan="3" Background="#E00A0A0C" Visibility="Collapsed" IsHitTestVisible="False">
      <Border BorderBrush="{StaticResource RuleStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Margin="24"
              Background="{StaticResource Paper2}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="Drop a .osu file" Foreground="{StaticResource Ink}" FontSize="{StaticResource TextXl}" FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Its maps will be found from the file alone." Foreground="{StaticResource Ink3}" HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
